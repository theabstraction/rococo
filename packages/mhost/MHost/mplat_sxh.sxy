(interface Rococo.Graphics.IFieldTesselator
	(Destruct  -> )

	(Seed (Int32 seedValue) -> )

	(InitByFixedCellWidth (const Sys.Maths.Quadf positions)(Float32 maxCellWidth)(Float32 maxCellHeight) -> )

	(InitByDivisions (const Sys.Maths.Quadf positions)(Int32 xDivs)(Int32 yDivs) -> )

	(SetUV (const Sys.Maths.Vec2 uvA)(const Sys.Maths.Vec2 uvC) -> )

	(NumberOfColumns  -> (Int32 cols))

	(NumberOfRows  -> (Int32 rows))

	(GetFlatSubQuad (Int32 i)(Int32 j)(out Rococo.QuadVertices subQuad) -> )

	/*  (0 0) -> top left. Average out perturbation and push quad along normal */
	(GetPerturbedSubQuad (Int32 i)(Int32 j)(out Rococo.QuadVertices q) -> )

	/*  (0 0) -> top left. Move each vertex out along normal. Use heigh gradient to modify normals */
	(GetStackBondedBrick (Int32 i)(Int32 j)(out Rococo.QuadVertices q)(Sys.SI.Metres cementWidth) -> )

	/*  (0 0) -> top left. Move each sub quad out along normal. */
	(GetStretchBondedBrick (Int32 i)(Int32 j)(out Rococo.QuadVertices q)(out Rococo.QuadVertices top)(out Rococo.QuadVertices left)(out Rococo.QuadVertices right)(out Rococo.QuadVertices bottom)(Sys.SI.Metres cementWidth)(Sys.SI.Metres extrusionBase) -> )

	/*  (0 0) -> top left. Move each sub quad out along normal. */
	(GetBrickJoinRight (Int32 i)(Int32 j)(out Rococo.QuadVertices q)(Sys.SI.Metres cementWidth) -> )

	(GetBrickBedTop (Int32 row)(out Rococo.QuadVertices q)(Sys.SI.Metres cementWidth) -> )

	(PerturbField (Int32 i)(Int32 j)(Float32 dH) -> )

	(LevelField (Int32 i0)(Int32 j0)(Int32 i1)(Int32 j1)(Float32 dH) -> )

	(RandomizeField (Int32 i)(Int32 j)(Float32 minValue)(Float32 maxValue) -> )

	(GetBasis (out Sys.Maths.Matrix4x4 transform) -> )
)

