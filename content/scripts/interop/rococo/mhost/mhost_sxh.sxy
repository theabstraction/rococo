(interface MHost.IDictionaryStream
	(AddBool (Sys.Type.IString name)(Bool value) -> )

	(AddI32 (Sys.Type.IString name)(Int32 value) -> )

	(AddI64 (Sys.Type.IString name)(Int64 value) -> )

	(AddF32 (Sys.Type.IString name)(Float32 value) -> )

	(AddF64 (Sys.Type.IString name)(Float64 value) -> )

	(AddString (Sys.Type.IString name)(Sys.Type.IString value) -> )

