(interface MHost.IEngine
	(PollKeyState (out MHost.OS.KeyState keys) -> )

	(GetNextMouseDelta (out Sys.Maths.Vec2 delta) -> )

	(GetNextMouseEvent (out MHost.OS.MouseEvent me) -> (Bool wasPopped))

	(GetNextKeyboardEvent (out MHost.OS.KeyboardEvent ke) -> (Bool wasPopped))

	(Render (MHost.GuiPopulator populator) -> )

	(AddSexmlSheet (Sys.Reflection.IExpression sexml) -> )

	(SetGreatSexOverlay (const Sys.Type.IString pingPathToSexml) -> )

	(IsAppModal  -> (Bool isModal))

	(IsRunning  -> (Bool isRunning))

	(Shutdown  -> )

	(YieldForSystemMessages (Int32 sleepMS) -> (Sys.SI.Seconds frameDT))

	(TryGetSpriteSpec (Sys.Type.IString resourceName)(out MPlat.BitmapLocation loc) -> (Bool isSuccessful))

	(GetSpriteSpec (Sys.Type.IString resourceName)(out MPlat.BitmapLocation loc) -> )

	(RunMPlatScript (Sys.Type.IString scriptName) -> )

	(SetNextScript (Sys.Type.IString scriptName) -> )

	(CaptureMouse  -> )

	(ReleaseMouse  -> )

	(CursorPosition (out Sys.Maths.Vec2 cursorPosition) -> )

	(SetGUIToggleKey (Int32 vkeyCode) -> )

	(SetEditorVisibility (Bool isVisible) -> )
)

