(namespace Rococo)
(macro Rococo.AlignmentFlagsNone in out (out.AddAtomic "0x0"))
(macro Rococo.AlignmentFlagsLeft in out (out.AddAtomic "0x1"))
(macro Rococo.AlignmentFlagsRight in out (out.AddAtomic "0x2"))
(macro Rococo.AlignmentFlagsBottom in out (out.AddAtomic "0x4"))
(macro Rococo.AlignmentFlagsTop in out (out.AddAtomic "0x8"))
(macro Rococo.AlignmentFlagsMirror in out (out.AddAtomic "0x10"))
(macro Rococo.AlignmentFlagsFlip in out (out.AddAtomic "0x20"))
(macro Rococo.AlignmentFlagsClipped in out (out.AddAtomic "0x40"))

(namespace MHost.GuiTypes)
(macro MHost.GuiTypes.EvIdNone in out (out.AddAtomic "0x0"))
(macro MHost.GuiTypes.EvIdGRisMadeVisible in out (out.AddAtomic "0x1"))
(macro MHost.GuiTypes.EvIdGRisHidden in out (out.AddAtomic "0x2"))
(macro MHost.GuiTypes.EvIdOverlayButtonClick in out (out.AddAtomic "0x3"))
(macro MHost.GuiTypes.EvIdLogMessage in out (out.AddAtomic "0x4"))

(namespace MHost)

(interface MHost.IGui
	(DrawTriangle (const MPlat.GuiTriangle t) -> )

	(DrawQuad (const MPlat.GuiQuad q) -> )

	(DrawBorder (const Sys.Maths.Rectf rect)(Float32 pxThickness)(Int32 tl)(Int32 tr)(Int32 bl)(Int32 br) -> )

	(FillRect (const Sys.Maths.Rectf rect)(Int32 colour) -> )

	(DrawColouredSprite (const Sys.Maths.Vec2 pixelPos)(Int32 alignmentFlags)(const MPlat.BitmapLocation loc)(Float32 blendFactor)(Int32 colour) -> )

	(DrawLeftAligned (const Sys.Maths.Rectf rect)(Sys.Type.IString text)(Int32 fontIndex)(Int32 fontHeight)(Int32 colour)(Float32 rightHardEdge)(Float32 rightSoftEdge) -> )

	(DrawScaledColouredSprite (const Sys.Maths.Vec2 pixelPos)(Int32 alignmentFlags)(const MPlat.BitmapLocation loc)(Float32 blendFactor)(Int32 colour)(Float32 scaleFactor) -> )

	(DrawSprite (const Sys.Maths.Vec2 pixelPos)(Int32 alignmentFlags)(const MPlat.BitmapLocation loc) -> )

	(StretchSprite (const Sys.Maths.Rectf rect)(const MPlat.BitmapLocation loc) -> )

	(DrawClippedText (const Sys.Maths.Rectf rect)(Int32 alignmentFlags)(Sys.Type.IString text)(Int32 fontIndex)(Int32 colour)(const Sys.Maths.Rectf clipRect) -> )

	(DrawTextWithCaret (const Sys.Maths.Rectf rect)(Int32 alignmentFlags)(Sys.Type.IString text)(Int32 fontIndex)(Int32 colour)(const Sys.Maths.Rectf clipRect)(Int32 caretPos) -> )

	(DrawText (const Sys.Maths.Rectf rect)(Int32 alignmentFlags)(Sys.Type.IString text)(Int32 fontIndex)(Int32 colour) -> )

	(EvalTextSpan (Sys.Type.IString text)(Int32 fontIndex)(out Sys.Maths.Vec2 pixelSpan) -> )

	(GetFontDescription (Int32 fontIndex)(Sys.Type.IStringBuilder familyName)(out MHost.Graphics.FontDesc fd) -> )

	(GetNumberOfFonts  -> (Int32 numberOfFonts))

	(GetScreenSpan (out Sys.Maths.Vec2 span) -> )

	(GetCursorPos (out Sys.Maths.Vec2 pos) -> )

	(SetGuiShaders (Sys.Type.IString pixelShaderFilename) -> )

	(SetScissorRect (const Sys.Maths.Recti rect) -> )

	(ClearScissorRect  -> )
)

